<!--
  Animal Food Preference — .csproj (SDK-style, net10.0)
  ====================================================
  
  SETUP:
  1. Ensure RimWorld.Paths.props exists two directories above Source\
     (at the Rimworld Mods\ root folder, outside any repo)
  2. Build: open AnimalFoodPreference.sln in Visual Studio, Ctrl+Shift+B
  
  PRIVACY: This csproj contains NO absolute paths and NO personal info.
  All machine-specific paths come from the imported .props file.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- ================================================================ -->
  <!-- Import machine-specific game paths (lives outside this repo)     -->
  <!-- ================================================================ -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('RimWorld.Paths.props', '$(MSBuildProjectDirectory)'))" />

  <!-- ================================================================ -->
  <!-- Project configuration                                            -->
  <!-- ================================================================ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>AnimalFoodPreference</RootNamespace>
    <AssemblyName>AnimalFoodPreference</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Guides animal food selection to prefer renewable sources first</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- CORE REFERENCES                                                  -->
  <!-- ================================================================ -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- HARMONY                                                          -->
  <!-- ================================================================ -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblies)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- UNITY MODULES — settings UI needs IMGUI + TextRendering          -->
  <!-- ================================================================ -->
  <ItemGroup>
  </ItemGroup>

</Project>
